# NonbiriAPI startup environment example.
# Copy this file to a private path, replace every CHANGE_ME value, and keep it
# readable only by root and the service account (see docs/first-run-setup.md).
# Never commit the real file.

# Listener. Bind to loopback when a reverse proxy terminates public TLS.
NONBIRI_LISTEN_ADDR=127.0.0.1:8080

# Persistent SQLite database. The service user must be able to write this path.
NONBIRI_DB_PATH=/var/lib/nonbiriapi/nonbiriapi.db

# info, debug, warn, or error.
NONBIRI_LOG_LEVEL=info

# Administrator credentials. Use a long unique password and do not reuse it.
NONBIRI_ADMIN_USERNAME=admin
NONBIRI_ADMIN_PASSWORD=CHANGE_ME_use_a_long_random_password

# Exactly one master-key source is required. The file must already exist,
# contain a canonical 32-byte hex/base64 key (or exactly 32 raw bytes), and be
# owner-only on Unix (0400 or 0600) and readable by the service account.
NONBIRI_MASTER_KEY_FILE=/etc/nonbiriapi/master.key
# NONBIRI_MASTER_KEY=CHANGE_ME_64_hex_characters

# Discord OAuth application credentials. Configure the callback URL as:
# https://<user-host>/api/auth/discord/callback
NONBIRI_DISCORD_CLIENT_ID=CHANGE_ME_discord_client_id
NONBIRI_DISCORD_CLIENT_SECRET=CHANGE_ME_discord_client_secret
# Optional; leave unset to use the safe default below. If overridden while new
# registration is enabled, retain both identity and guild-member access.
# NONBIRI_DISCORD_OAUTH_SCOPES=identify guilds.members.read

# Public user origin and a different administrator host.
# The values must be origins/hostnames, not paths.
NONBIRI_SITE_BASE_URL=https://api.example.com
NONBIRI_ADMIN_HOST=admin.example.com

# Only trust forwarding headers from your reverse proxy addresses. Use
# "none" if the process receives traffic directly without a trusted proxy.
NONBIRI_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# SMTP is reserved in the current prereleases and is not used for email alerts. If configured,
# all fields below are validated at startup.
# NONBIRI_SMTP_HOST=smtp.example.com
# NONBIRI_SMTP_PORT=587
# NONBIRI_SMTP_USER=CHANGE_ME
# NONBIRI_SMTP_PASS=CHANGE_ME
# NONBIRI_SMTP_FROM=alerts@example.com
# NONBIRI_SMTP_TLS=starttls
